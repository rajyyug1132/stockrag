NVIDIA_API_KEY=
GEMINI_API_KEY=
SEC_USER_AGENT="StockRAG/0.1 rajyyug@gmail.com"

# Generation provider: nvidia (default, NIM) | gemini | ollama (fully local).
# Small local models often answer without [n] citations, which the citation
# gate in rag/answer.py turns into a refusal — prefer nvidia for demos.
# LLM_PROVIDER=nvidia
# OLLAMA_MODEL=qwen3:4b

# Reranker: local (default, cross-encoder) | nvidia (hosted nemotron-3.5-rerank-8b,
# uses NVIDIA_API_KEY, falls back to local on any error).
# RERANKER_PROVIDER=nvidia

# Ephemeral-disk hosts: ingest these tickers (comma-separated) in a background
# thread at API startup. Empty/unset = off.
# AUTO_INGEST_TICKERS=AAPL,MSFT

# Retrieval backend: chroma (default, local disk) | supabase (pgvector + full-text).
# The service key is server-side only: never put it in a VITE_ variable.
# VECTOR_STORE=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Embeddings: local (default, bge on CPU) | nvidia (hosted NIM, uses NVIDIA_API_KEY).
# An index must be queried with the embeddings it was built with.
# EMBEDDING_PROVIDER=nvidia
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# NVIDIA_EMBED_DIM=1024  # must match vector(N) in supabase/migrations
